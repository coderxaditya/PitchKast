# ── Dependencies ──────────────────────────────────────────────
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# ── Build output ──────────────────────────────────────────────
.next
out
build
dist
next-env.d.ts
*.tsbuildinfo

# ── Env & secrets ─────────────────────────────────────────────
# Never commit real credentials. Commit .env.example instead.
.env
.env.*
!.env.example

# ── Logs & debug ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Test & coverage ───────────────────────────────────────────
coverage
.nyc_output
playwright-report
test-results

# ── Agent tooling (local only) ────────────────────────────────
# `skills/` holds two cloned repos that keep their own .git directories.
# Committing them would record bare gitlinks with no submodule config, so
# a fresh clone gets empty folders and every symlink below breaks.
skills/
skills-lock.json
.agents/
# Symlinks into the two directories above — worthless without their targets.
.claude/skills/
.claude/settings.local.json
.claude/launch.json

# ── Local reference material ──────────────────────────────────
# Source tutorials/snippets kept on disk while porting a technique. The
# implementations live in the codebase; these are notes, not project files.
tutorial-*.html

# ── Editor / OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea
*.swp
.vscode/*
!.vscode/extensions.json

# ── Deploy ────────────────────────────────────────────────────
.vercel

# Derived from public/assets/final.mp4 by `npm run frames` (~23MB of JPEGs).
# Regenerated automatically by predev/prebuild, so a fresh clone and CI both
# rebuild them instead of carrying them in git.
public/assets/frames/
backups/
